# Copy this file to .env and fill in real values for local development.
# Values here are examples only. 


DB_URL=jdbc:postgresql://ep-xxxx-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=your-neon-password

# Optional. If unset, the AI chat panel is simply disabled.
# Get a key at https://console.groq.com
GROQ_API_KEY=gsk_your-key-here